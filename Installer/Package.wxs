<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    Per-machine install to Program Files\RaiderLite with a Start menu shortcut.

    Upgrades: running a newer installer replaces the installed version. MajorUpgrade removes the
    old version inside the same transaction as installing the new one, so a failure or cancel
    restores the old version. Older installers refuse to run over a newer install. A rebuilt
    installer with the same version also replaces the installed one, so forgetting to bump the
    version can't leave two copies side by side.

    Settings live in %APPDATA%\RaiderLite and are never touched by install, upgrade or uninstall.

    The UpgradeCode identifies RaiderLite across versions: never change it, or new installers
    won't find and replace old installs.
  -->
  <Package Name="RaiderLite"
           Manufacturer="Donour Sizemore"
           Version="$(var.ProductVersion)"
           UpgradeCode="1753CBF2-AFBD-4E66-B7CD-0A549A993F7F"
           Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of RaiderLite is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- There is no maintenance UI, so hide "Change" in Installed Apps (Repair and Uninstall remain). -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RaiderLite">
        <Files Include="$(var.PublishDir)**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="RaiderLiteShortcut"
                  Name="RaiderLite"
                  Description="ECU map editor using RomRaider XML definitions"
                  Target="[INSTALLFOLDER]RaiderLite.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\RaiderLite\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

  </Package>

</Wix>
