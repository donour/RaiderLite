<Project>

  <!--
    Product version, shared by the app and the installer. Windows Installer only compares the
    first three fields, so bump major, minor or patch for every release: an installer whose
    version differs only in a fourth field is not treated as an upgrade.
  -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Product>RaiderLite</Product>
    <Company>Donour Sizemore</Company>
    <Copyright>Copyright © 2026 Donour Sizemore</Copyright>
  </PropertyGroup>

</Project>
